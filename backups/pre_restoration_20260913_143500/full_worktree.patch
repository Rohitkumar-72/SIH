+def apply_right_hand_sublanes(waypoints, main_corridors_cells, origin, resolution, offset_m=0.40):
+    """Offset waypoints in 3.0m multi-robot main corridors into right-hand directional sublanes.
+
+    Invariants:
+    - Only waypoints within main corridor cells are offset.
+    - Final destination waypoint is NEVER offset so task stations and docks are reached precisely.
+    - Lateral offset vector is perpendicular to travel direction to the right: n_right = (u_y, -u_x).
+    - Opposing traffic in the same main corridor achieves 2 * offset_m = 0.80m lateral separation.
+    """
+    if not waypoints or len(waypoints) < 2 or not main_corridors_cells:
+        return waypoints
+
+    origin_x, origin_y = origin
+    n_pts = len(waypoints)
+    result = list(waypoints)
+
+    def get_xy(p):
+        if hasattr(p, 'x'):
+            return float(p.x), float(p.y)
+        return float(p[0]), float(p[1])
+
+    for i in range(n_pts - 1):  # Do not modify the final destination waypoint
+        wx, wy = get_xy(waypoints[i])
+        cx = round((wx - origin_x) / resolution)
+        cy = round((wy - origin_y) / resolution)
+        if (cx, cy) not in main_corridors_cells:
+            continue
+
+        next_wx, next_wy = get_xy(waypoints[i + 1])
+        dx = next_wx - wx
+        dy = next_wy - wy
+        dist = math.hypot(dx, dy)
+        if dist < 1e-4:
+            continue
+
+        # Right-hand normal vector: n_right = (u_y, -u_x)
+        ux = dx / dist
+        uy = dy / dist
+        nx = uy
+        ny = -ux
+
+        new_x = wx + offset_m * nx
+        new_y = wy + offset_m * ny
+
+        orig_wp = waypoints[i]
+        if hasattr(orig_wp, 'x'):
+            wp_type = type(orig_wp)
+            result[i] = wp_type(x=new_x, y=new_y, theta=getattr(orig_wp, 'theta', 0.0))
+        elif isinstance(orig_wp, tuple) and len(orig_wp) == 3:
+            result[i] = (new_x, new_y, orig_wp[2])
+        else:
+            result[i] = (new_x, new_y)
+
+    return result
+
+
