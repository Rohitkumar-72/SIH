+def corridor_axial_holding_cell(corridor_cells, grid_width, grid_height,
+                                static_blocked, occupied_corridor_cells,
+                                start_cell, resolution_m=0.5,
+                                approach_dist_m=2.0):
+    """Select a reachable holding cell at the far edge of the approach zone for an occupied corridor.
+
+    Invariants:
+    - Uses only axial entrances based on corridor orientation (X or Y).
+    - Places the holding cell at the far edge of the approach zone (approach_dist_m, e.g. 2.0m),
+      never the immediately adjacent boundary cell.
+    - Ensures holding point is outside the corridor footprint and does not obstruct the exit.
+    """
+    if not corridor_cells:
+        return None
+
+    xs = [c[0] for c in corridor_cells]
+    ys = [c[1] for c in corridor_cells]
+    min_x, max_x = min(xs), max(xs)
+    min_y, max_y = min(ys), max(ys)
+    span_x = (max_x - min_x) * resolution_m
+    span_y = (max_y - min_y) * resolution_m
+    axis = 'x' if span_x >= span_y else 'y'
+
+    approach_cells = max(1, round(approach_dist_m / resolution_m))
+
+    # Generate axial candidates for both ends, testing from approach_cells down to 2
+    # (strictly offset >= 2 cells to avoid the immediate 1-cell mouth)
+    axial_entrances = []
+    if axis == 'x':
+        # Corridor runs along X; axial mouths are at min_x (West) and max_x (East)
+        west_candidates = []
+        for offset in range(approach_cells, 1, -1):
+            x_cand = min_x - offset
+            for y_cand in range(min_y, max_y + 1):
+                if 0 <= x_cand < grid_width and 0 <= y_cand < grid_height:
+                    west_candidates.append((x_cand, y_cand, offset))
+
+        east_candidates = []
+        for offset in range(approach_cells, 1, -1):
+            x_cand = max_x + offset
+            for y_cand in range(min_y, max_y + 1):
+                if 0 <= x_cand < grid_width and 0 <= y_cand < grid_height:
+                    east_candidates.append((x_cand, y_cand, offset))
+
+        axial_entrances = [west_candidates, east_candidates]
+    else:
+        # Corridor runs along Y; axial mouths are at min_y (South) and max_y (North)
+        south_candidates = []
+        for offset in range(approach_cells, 1, -1):
+            y_cand = min_y - offset
+            for x_cand in range(min_x, max_x + 1):
+                if 0 <= x_cand < grid_width and 0 <= y_cand < grid_height:
+                    south_candidates.append((x_cand, y_cand, offset))
+
+        north_candidates = []
+        for offset in range(approach_cells, 1, -1):
+            y_cand = max_y + offset
+            for x_cand in range(min_x, max_x + 1):
+                if 0 <= x_cand < grid_width and 0 <= y_cand < grid_height:
+                    north_candidates.append((x_cand, y_cand, offset))
+
+        axial_entrances = [south_candidates, north_candidates]
+
+    # Filter candidates by:
+    # 1. Strictly outside corridor footprint
+    # 2. Not in static_blocked
+    # 3. Not in occupied_corridor_cells
+    blocked = set(static_blocked) | set(occupied_corridor_cells) | set(corridor_cells)
+
+    valid_per_entrance = []
+    for candidates in axial_entrances:
+        valid = [c for c in candidates if (c[0], c[1]) not in blocked]
+        if valid:
+            valid_per_entrance.append(valid)
+
+    if not valid_per_entrance:
+        return None
+
+    # Pick the entrance closest to start_cell
+    def entrance_dist_to_start(cand_list):
+        return min(abs(c[0] - start_cell[0]) + abs(c[1] - start_cell[1]) for c in cand_list)
+
+    chosen_entrance_candidates = min(valid_per_entrance, key=entrance_dist_to_start)
+
+    # Within the chosen entrance, prefer the farthest setback (max offset)
+    chosen_entrance_candidates.sort(
+        key=lambda c: (-c[2], abs(c[0] - start_cell[0]) + abs(c[1] - start_cell[1]))
+    )
+
+    best = chosen_entrance_candidates[0]
+    return (best[0], best[1])
+
