+def test_data_collection_node_completed_task_registration(tmp_path):
+    """Verify DataCollectionNode registers completed tasks into self.completed_tasks."""
+    import rclpy
+    from sih_amr_fleet.data_collection_node import DataCollectionNode
+    from sih_amr_interfaces.msg import TaskExecutionStatus
+
+    shutdown_at_end = False
+    if not rclpy.ok():
+        rclpy.init()
+        shutdown_at_end = True
+
+    log_file = tmp_path / "telemetry.jsonl"
+    node = DataCollectionNode()
+    try:
+        assert len(node.completed_tasks) == 0
+
+        # Non-completed status (e.g. EN_ROUTE_PICKUP) should NOT add to completed_tasks
+        msg1 = TaskExecutionStatus()
+        msg1.owner_robot_id = 'robot_1'
+        msg1.fleet_header.session_id = 'sess_1'
+        msg1.fleet_header.sequence_no = 1
+        msg1.task_id = 'rnd_task_001'
+        msg1.phase = TaskExecutionStatus.EN_ROUTE_PICKUP
+        node.on_execution(msg1)
+        assert 'rnd_task_001' not in node.completed_tasks
+
+        # Completed status MUST add to completed_tasks
+        msg2 = TaskExecutionStatus()
+        msg2.owner_robot_id = 'robot_1'
+        msg2.fleet_header.session_id = 'sess_1'
+        msg2.fleet_header.sequence_no = 2
+        msg2.task_id = 'rnd_task_001'
+        msg2.phase = TaskExecutionStatus.COMPLETED
+        node.on_execution(msg2)
+        assert 'rnd_task_001' in node.completed_tasks
+        assert len(node.completed_tasks) == 1
+    finally:
+        node.destroy_node()
+        if shutdown_at_end:
+            rclpy.shutdown()
+
+
